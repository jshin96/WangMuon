# This is a note to Condor, the computer-job queue, about how to run jobs.
# --- Basic Job Configuration ---
executable              = run_sim_job.sh
# The first two numbers make the output-file name unique.  room_material is
# retained for compatibility with old submission commands; this beam setup
# does not use a mound or room.
getenv                  = True

# Send this small instruction file to each worker computer.
transfer_input_files    = run.mac
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT

# Save anything the program says, and any errors, into these log files.
output                  = logs/muon_flux_spectrometer_$(room_material)_$(Cluster)_$(Process).out
error                   = logs/muon_flux_spectrometer_$(room_material)_$(Cluster)_$(Process).err
log                     = logs/muon_flux_spectrometer_$(room_material)_$(Cluster).log

# Ask for one CPU and modest memory/disk space.
request_cpus            = 1
request_memory          = 2GB
request_disk            = 2GB

# Make 100 jobs.  The old soil/air labels are harmless compatibility tags.
queue 100 room_material in (
    soil
    air
)
