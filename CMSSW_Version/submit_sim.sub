# --- Basic Job Configuration ---
executable              = run_sim_job.sh
arguments               = $(Cluster) $(Process) $(room_material)
getenv                  = True

# --- File Transfer ---
transfer_input_files    = run.mac
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT

# --- Logging ---
output                  = logs/wang_muon_$(room_material)_$(Cluster)_$(Process).out
error                   = logs/wang_muon_$(room_material)_$(Cluster)_$(Process).err
log                     = logs/wang_muon_$(room_material)_$(Cluster).log

# --- Resources ---
request_cpus            = 1
request_memory          = 2GB
request_disk            = 2GB

# --- Launch ---
queue 100 room_material in (
    soil
    air
)
