# main.cc initializes the physics and geometry before executing this macro.
# Do not issue a second /run/initialize here: Geant4 then stops processing the
# macro before it reaches /run/beamOn, leaving no ROOT output.

# The source is conditioned on the uphill/downhill detector window configured
# by run_sim_job.sh. It preserves EcoMug draws inside that proposal window but
# is not an unconditioned full-sky absolute-flux simulation.
/run/beamOn 10000
